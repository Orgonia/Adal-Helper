# Скопируйте этот файл в .env.local и заполните значения.
# .env.local не попадает в git (см. .gitignore): ключи никогда не коммитим.

# --- База данных: MongoDB Atlas (нужен кластер с Vector Search) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=adal_qogam

# --- ИИ: Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Резервные модели через запятую: используются, если основная перегружена (503),
# недоступна или не начала отвечать за GEMINI_FIRST_CHUNK_TIMEOUT_MS миллисекунд
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
GEMINI_FIRST_CHUNK_TIMEOUT_MS=15000
# Необязательно: бюджет «размышлений» модели (0 = быстрее и дешевле)
GEMINI_THINKING_BUDGET=
# Необязательно: лимит запросов эмбеддингов в минуту при загрузке документов
EMBED_RATE_PER_MIN=80

# --- Авторизация: Auth.js (NextAuth v5) ---
# Сгенерировать: npx auth secret   (или openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google OAuth: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth (необязательно): https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Приложение ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# E-mail администраторов через запятую: им доступна страница /stats
ADMIN_EMAILS=

# --- Настройки RAG и защиты ---
# Порог релевантности фрагментов (0..1), калибруется через npm run search
RAG_MIN_SCORE=0.84
# Запросов в минуту к чату с одного гостя (вошедшим вдвое больше)
CHAT_RATE_LIMIT_PER_MIN=10
